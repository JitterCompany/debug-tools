	(text "EMC filter\nFco (Common-mode): 17.3kHz\nFco (Diff-mode): 58kHz\n\nElectrolytic capacitor provides damping:\nCdamp >> 5 * C_ceramic\nESR >= sqrt(L * C_ceramic)\n"
		(exclude_from_sim no)
		(at 91.44 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
