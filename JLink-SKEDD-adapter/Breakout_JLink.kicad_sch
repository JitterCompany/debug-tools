	(text "Mates with \nWurth 490107670612S"
		(exclude_from_sim no)
		(at 123.444 136.144 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "cc481167-828e-4a4c-af4d-5f3bd672f198")
	)
	(text "We use a client side uart connector. \nThe purpose is to connect another serial converter \nwhich acts as the host. Thus we need a connector \nfrom the client's perspective here.\nThis means that the Rx pin on this connector is the client's (DUT) Rx pin, \nwhich enters this board on the Tx pin of the host-side Redfit connector.\n"
		(exclude_from_sim no)
		(at 125.095 76.2 0)
		(effects
			(font
				(size 0.65 0.65)
			)
			(justify left bottom)
		)
		(uuid "dc54a2bb-dbd6-498d-8e9e-4b48cd058457")
	)
	(text "Optional header for some extra signals"
		(exclude_from_sim no)
		(at 198.12 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e5168a54-7dfa-4c54-9d18-c4bfc451ae93")
	)
	(text "Pullup to keep Rx idle\nwhile client keeps it\nfloating (e.g. in reset)"
		(exclude_from_sim no)
		(at 159.385 117.475 0)
		(effects
			(font
				(size 0.65 0.65)
			)
			(justify left bottom)
		)
		(uuid "f764168b-a412-4219-814c-c68c8feb9937")
	)
